{
  "version": 2,
  "functions": {
    "api/index.js": { "includeFiles": "{dashboard/dist/**,plugin/marketer-companion-dashboard/**,skills/**}" }
  },
  "crons": [
    { "path": "/cron/clarity-snapshots", "schedule": "30 0 * * *" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
